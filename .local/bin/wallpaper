#!/usr/bin/env bash
# wallpaper --restore  -> show the chosen wallpaper with its settings (login, and wallpaper-ui after Enter)
# The picker itself is ~/.local/bin/wallpaper-ui (Super+Ctrl+Space).
LINK="$HOME/.config/hypr/wallpaper"          # original image (hyprlock uses it too); missing = plain paper colour
CONF="$HOME/.config/hypr/wallpaper.conf"     # BRIGHT / BLUR / WASH / MODE
CUR="$HOME/.cache/wallpaper-current.jpg"     # the adjusted copy swaybg shows

BRIGHT=100 BLUR=none WASH=0 MODE=fill
[ -f "$CONF" ] && . "$CONF"

img="$LINK"
if [ -e "$LINK" ] && { [ "$BRIGHT" != 100 ] || [ "$BLUR" != none ] || [ "$WASH" != 0 ]; }; then
    case "$BLUR" in soft) b="-blur 0x4" ;; medium) b="-blur 0x10" ;; strong) b="-blur 0x20" ;; *) b="" ;; esac
    # shellcheck disable=SC2086  # $b is either empty or two words on purpose
    magick "$LINK[0]" -modulate "$BRIGHT" $b -fill '#ebdbb2' -colorize "$WASH%" -quality 92 "$CUR" && img="$CUR"
fi

pkill -x swaybg
if [ -e "$img" ]; then
    setsid -f swaybg -i "$img" -m "$MODE" -c '#282828' </dev/null >/dev/null 2>&1   # fully detached: never hold the caller's terminal open
else
    setsid -f swaybg -c '#282828' </dev/null >/dev/null 2>&1   # fully detached: never hold the caller's terminal open
fi
