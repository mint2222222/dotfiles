// dwm-style bar: tags | layout | title ............ status
{
    "layer": "top",
    "position": "top",
    "height": 24,
    "spacing": 0,

    "modules-left":   ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right":  ["cpu", "memory", "wireplumber", "network", "battery", "tray"],

    "hyprland/workspaces": {
        "format": "{id}",
        "all-outputs": true,
        "persistent-workspaces": { "1": [], "2": [], "3": [], "4": [], "5": [] },
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },
    "hyprland/window": {
        "format": " {} ",
        "max-length": 80,
        "separate-outputs": true
    },
    "cpu": {
        "interval": 5,
        "format": "CPU {usage}%"
    },
    "memory": {
        "interval": 10,
        "format": "MEM {used:0.1f}G"
    },
    "wireplumber": {
        "format": "VOL {volume}%",
        "format-muted": "VOL MUTE",
        "on-click": "~/.local/bin/volume mute",
        "on-scroll-up": "~/.local/bin/volume up 5",
        "on-scroll-down": "~/.local/bin/volume down 5",
        "on-click-right": "easyeffects",
        "max-volume": 150
    },
    "network": {
        "interval": 10,
        "format-wifi": "NET {essid}",
        "format-ethernet": "NET wired",
        "format-disconnected": "NET off",
        "tooltip-format": "{ifname} {ipaddr}"
    },
    "battery": {
        "interval": 30,
        "states": { "warning": 25, "critical": 10 },
        "format": "BAT {capacity}%",
        "format-charging": "BAT {capacity}%+",
        "format-plugged": "BAT {capacity}%+"
    },
    "clock": {
        "interval": 30,
        "format": "{:%a %d %b  %H:%M}",
        "on-click-right": "~/.local/bin/waybar-bg",
        "tooltip-format": "<tt>{calendar}</tt>"
    },
    "tray": {
        "icon-size": 14,
        "spacing": 6
    }
}
